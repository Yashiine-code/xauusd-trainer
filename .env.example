MARKET_DATA_MODE=postgres
PHASE2_ENABLED=false

# R2 POC only: set MARKET_DATA_MODE=r2 and bind MARKET_DATA_BUCKET.
# Production remains postgres until the POC is explicitly approved.

# Local Node/Vinext and the Cloudflare request-scoped pooler fallback.
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/postgres

# Recommended for hosted Sites: PostgREST avoids raw TCP in Cloudflare Workers.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-a-public-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key

# Keep the local postgres.js pool deliberately small.
DATABASE_POOL_SIZE=2
